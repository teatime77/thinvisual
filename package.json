{
  "name": "thinvisual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML-over-the-wire applications with a GUI designer",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
